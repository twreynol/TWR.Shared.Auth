<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>TWR.Shared.Auth</PackageId>
    <Version>1.2.1</Version>
    <RepositoryUrl>https://github.com/twreynol/TWR.Shared.Auth</RepositoryUrl>
    <Description>Shared MyFamilyAuth login experience for the TWR MyApps suite — IAuthService, LoginForm/ForgotPasswordForm components, and passkey (WebAuthn) support, so consuming apps configure and drop in a component instead of hand-building their own auth wiring.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TWR.Shared.Auth.Tests\**" />
    <Content Remove="TWR.Shared.Auth.Tests\**" />
    <None Remove="TWR.Shared.Auth.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="TWR.MyFamilyAuth.Contracts" Version="1.3.0" />
  </ItemGroup>

</Project>
